# Paste these into the Vercel project (Production and Preview).
# Do not commit a filled-in copy of this file.

APP_NAME=AGAPORA
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://YOUR_VERCEL_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Supabase session pooler (IPv4). Use port 5432, not the 6543 transaction pooler.
# Host looks like aws-0-REGION.pooler.supabase.com
# Username looks like postgres.YOUR_PROJECT_REF
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require
DB_EMULATE_PREPARES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_DRIVER=s3
QUEUE_CONNECTION=sync
# File cache stays on the container. The database store would send every cache read back to Supabase.
CACHE_STORE=file

# Supabase Storage, S3-compatible. Create a public bucket named agapora first.
# Keys: Project Settings → Storage → S3 Access Keys.
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=YOUR_SUPABASE_REGION
AWS_BUCKET=agapora
AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/agapora
AWS_USE_PATH_STYLE_ENDPOINT=true

CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_DOMAIN

# Optional. Chick images and the written interpretation stay off until these are set.
OFFSPRING_IMAGE_ENABLED=false
OFFSPRING_IMAGE_AUTO=false
OFFSPRING_IMAGE_PROVIDER=openrouter
OFFSPRING_IMAGE_FALLBACK_PROVIDER=huggingface
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3-pro-image
OPENROUTER_IMAGE_ASPECT_RATIO=4:3
OPENROUTER_IMAGE_TIMEOUT=180
HF_TOKEN=
HF_IMAGE_MODEL=krea/Krea-2-Turbo
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_TIMEOUT=180
AGAPORA_AI_ENABLED=false
AGAPORA_AI_AUTO=true
AGAPORA_AI_VISUAL_DESCRIPTION_ENABLED=true
AGAPORA_AI_PROVIDER=groq
AGAPORA_AI_BASE_URL=https://api.groq.com/openai/v1
AGAPORA_AI_MODEL=llama-3.3-70b-versatile
AGAPORA_AI_API_KEY=
GROQ_API_KEY=
